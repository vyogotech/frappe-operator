{
  "name": "frappe-console-plugin",
  "version": "5.2.0",
  "displayName": "Frappe & ERPNext Platform",
  "description": "Frappe-native management for Benches and Tenant Sites: form-based provisioning, migrate/backup/restore/app-install actions, external database and Redis support, and an air-gapped FPM package store. By Vyogo Technologies",
  "dependencies": {
    "@console/pluginAPI": "*"
  },
  "extensions": [
    {
      "type": "console.navigation/section",
      "properties": {
        "id": "frappe-nav-section",
        "name": "Frappe Platform",
        "insertAfter": "workloads"
      }
    },
    {
      "type": "console.navigation/href",
      "properties": {
        "id": "frappe-benches-nav",
        "section": "frappe-nav-section",
        "name": "Frappe Benches",
        "href": "/frappe/benches"
      }
    },
    {
      "type": "console.navigation/href",
      "properties": {
        "id": "frappe-sites-nav",
        "section": "frappe-nav-section",
        "name": "Tenant Sites",
        "href": "/frappe/sites"
      }
    },
    {
      "type": "console.navigation/href",
      "properties": {
        "id": "frappe-fpm-store-nav",
        "section": "frappe-nav-section",
        "name": "FPM Package Store",
        "href": "/frappe/fpm-store"
      }
    },
    {
      "type": "console.page/route",
      "properties": {
        "exact": true,
        "path": "/frappe/benches",
        "component": {
          "$codeRef": "BenchesDashboard"
        }
      }
    },
    {
      "type": "console.page/route",
      "properties": {
        "exact": true,
        "path": "/frappe/sites",
        "component": {
          "$codeRef": "SitesDirectory"
        }
      }
    },
    {
      "type": "console.page/route",
      "properties": {
        "exact": true,
        "path": "/frappe/fpm-store",
        "component": {
          "$codeRef": "FPMStore"
        }
      }
    },
    {
      "type": "console.tab/horizontalNav",
      "properties": {
        "model": {
          "group": "vyogo.tech",
          "version": "v1",
          "kind": "FrappeBench"
        },
        "page": {
          "name": "FPM Packages",
          "href": "fpm-packages"
        },
        "component": {
          "$codeRef": "BenchFPMTab"
        }
      }
    },
    {
      "type": "console.tab/horizontalNav",
      "properties": {
        "model": {
          "group": "vyogo.tech",
          "version": "v1",
          "kind": "FrappeBench"
        },
        "page": {
          "name": "Tenant Sites",
          "href": "tenant-sites"
        },
        "component": {
          "$codeRef": "BenchSitesTab"
        }
      }
    },
    {
      "type": "console.tab/horizontalNav",
      "properties": {
        "model": {
          "group": "vyogo.tech",
          "version": "v1",
          "kind": "FrappeBench"
        },
        "page": {
          "name": "Resource Metrics",
          "href": "resource-metrics"
        },
        "component": {
          "$codeRef": "BenchMetricsTab"
        }
      }
    },
    {
      "type": "console.tab/horizontalNav",
      "properties": {
        "model": {
          "group": "vyogo.tech",
          "version": "v1",
          "kind": "FrappeSite"
        },
        "page": {
          "name": "Database & Redis",
          "href": "data-services"
        },
        "component": {
          "$codeRef": "SiteDatabaseTab"
        }
      }
    },
    {
      "type": "console.page/route",
      "properties": {
        "exact": true,
        "path": "/frappe/benches/~new",
        "component": {
          "$codeRef": "BenchCreateForm"
        }
      }
    },
    {
      "type": "console.page/route",
      "properties": {
        "exact": true,
        "path": "/frappe/sites/~new",
        "component": {
          "$codeRef": "SiteCreateForm"
        }
      }
    },
    {
      "type": "console.tab/horizontalNav",
      "properties": {
        "model": {
          "group": "vyogo.tech",
          "version": "v1",
          "kind": "FrappeBench"
        },
        "page": {
          "name": "Data Services",
          "href": "data-services"
        },
        "component": {
          "$codeRef": "BenchDataServicesTab"
        }
      }
    },
    {
      "type": "console.tab/horizontalNav",
      "properties": {
        "model": {
          "group": "vyogo.tech",
          "version": "v1",
          "kind": "FrappeSite"
        },
        "page": {
          "name": "Operations",
          "href": "operations"
        },
        "component": {
          "$codeRef": "SiteOperationsTab"
        }
      }
    },
    {
      "type": "console.action/resource-provider",
      "properties": {
        "model": {
          "group": "vyogo.tech",
          "version": "v1",
          "kind": "FrappeSite"
        },
        "provider": {
          "$codeRef": "frappeActions.useFrappeSiteActions"
        }
      }
    },
    {
      "type": "console.action/resource-provider",
      "properties": {
        "model": {
          "group": "vyogo.tech",
          "version": "v1",
          "kind": "FrappeBench"
        },
        "provider": {
          "$codeRef": "frappeActions.useFrappeBenchActions"
        }
      }
    }
  ]
}
